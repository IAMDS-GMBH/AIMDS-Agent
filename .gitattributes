# Auto-generated files — collapse diffs and exclude from language stats
web/package-lock.json linguist-generated=true

# Enforce LF for scripts that run inside Linux containers.
# Without this, Windows checkout converts to CRLF and breaks `exec` in the
# container entrypoint with "no such file or directory".
*.sh        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
docker/entrypoint.sh text eol=lf

# Source package (AIS-311/AIS-322, scripts/build_source_package.sh): `git
# archive` honours export-ignore, so everything listed here stays out of the
# public hermes-source-<version>.zip. Rule: the archive carries only what the
# installed client needs to run, build its UIs and update itself — nothing
# that describes internal workflows, CI, planning, tooling, container
# deployment or documentation ships to customers.
.github/                 export-ignore
.agents/                 export-ignore
.gitattributes           export-ignore
tests/                   export-ignore
apps/bootstrap-installer/ export-ignore
docs/                    export-ignore
createTag.sh             export-ignore
CONTRIBUTING.md          export-ignore
SECURITY.md              export-ignore
# README screenshots and PR/design material
assets/                  export-ignore
apps/desktop/pr-assets/  export-ignore
apps/desktop/DESIGN.md   export-ignore
apps/desktop/preview-demo.html export-ignore
# Container deployment (built from the repository, never from the archive)
docker/                  export-ignore
Dockerfile               export-ignore
.dockerignore            export-ignore
# Developer / CI / release tooling under scripts/. Kept in the archive:
# install.sh, install.ps1, install.cmd, lib/, whatsapp-bridge/, hermes-gateway,
# set_version.py, install_psutil_android.py, run_tests.sh, keystroke_diagnostic.py.
scripts/release.py       export-ignore
scripts/build_source_package.sh export-ignore
scripts/run_tests_parallel.py export-ignore
scripts/lint_diff.py     export-ignore
scripts/check-windows-footguns.py export-ignore
scripts/check-windows-docx-env.ps1 export-ignore
scripts/check_subprocess_stdin.py export-ignore
scripts/contributor_audit.py export-ignore
