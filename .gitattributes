scripts/sample_and_compress.py export-ignore
scripts/benchmark_browser_eval.py export-ignore
scripts/tool_search_livetest.py export-ignore
scripts/analyze_livetest.py export-ignore
scripts/LIVETEST_README.md export-ignore
scripts/build_model_catalog.py export-ignore
scripts/discord-voice-doctor.py export-ignore
