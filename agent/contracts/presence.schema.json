{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aimds-agent:contract:presence:1",
  "title": "Presence",
  "description": "A running agent announcing itself to the agent bus: where it runs and what it can do until it expires.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "device", "posture", "capabilities", "version", "runner", "ts", "expires"],
  "properties": {
    "v": { "const": 1, "description": "Contract version." },
    "device": { "type": "string", "maxLength": 200, "description": "Stable device id." },
    "posture": { "enum": ["general", "coding", "developer"], "description": "Operating posture of the surface." },
    "capabilities": { "type": "array", "items": { "type": "string", "maxLength": 120 }, "description": "Capability names, e.g. toolsets or MCP servers it can serve." },
    "version": { "type": "string", "maxLength": 40, "description": "Agent version." },
    "runner": { "$ref": "#/$defs/Runner" },
    "ts": { "type": "string", "description": "ISO 8601 time of the announcement." },
    "expires": { "type": "string", "description": "ISO 8601 time after which the presence is stale." }
  },
  "$defs": {
    "Runner": {
      "description": "Where the agent runs: on the user's device or in the Suite.",
      "enum": ["local", "suite"]
    }
  }
}
